---
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import StudioCase from '../../../components/studio/StudioCase.astro';
import {publicProjects} from '../../../data/studio';
import {localizeProject} from '../../../i18n/content';
import {SITE} from '../../../data/site';
export function getStaticPaths(){return publicProjects.map(project=>({params:{slug:project.slug},props:{project}}));}
const project=localizeProject(Astro.props.project,'id');
const structuredData={'@context':'https://schema.org','@type':project.githubUrl?'SoftwareSourceCode':'CreativeWork',name:project.title,description:project.description,url:new URL(Astro.url.pathname,SITE.url).toString(),creator:{'@type':'Person',name:SITE.name},codeRepository:project.githubUrl??project.githubLinks?.[0]?.url};
---
<BaseLayout title={project.seoTitle??project.title+' — '+SITE.name} description={project.seoDescription??project.description} image={project.screenshot} structuredData={structuredData}><StudioCase project={project} lang="id"/></BaseLayout>
