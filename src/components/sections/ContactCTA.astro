---
import { resolveLang, t } from "../../i18n/utils";
import { SITE } from "../../data/site";

const lang = resolveLang(Astro.url.searchParams.get("lang"), Astro.url.pathname);
const contactReturnUrl = new URL(lang === "id" ? "/id/?sent=1#contact" : "/?sent=1#contact", Astro.site ?? Astro.url.origin).toString();
---

<section id="contact" class="section">
  <div class="container-lg">
    <div class="max-w-3xl mx-auto text-center px-2 md:px-0">
      <span class="section-num">06.</span>
      <h2 class="text-2xl md:text-4xl lg:text-5xl font-bold text-white mt-3 mb-4 md:mb-6" set:html={t(lang, "contact.heading")}>
      </h2>
      <p class="text-base md:text-lg text-text-secondary mb-8 md:mb-10 max-w-xl mx-auto">
        {t(lang, "contact.subtitle")}
      </p>

      <div class="work-paths" aria-labelledby="work-paths-label">
        <p id="work-paths-label" class="work-paths-label">{t(lang, "contact.pathsLabel")}</p>
        <article class="work-path work-path-software">
          <div class="work-path-copy">
            <span class="work-path-kicker">AI / FULL-STACK</span>
            <h3>{t(lang, "contact.softwareTitle")}</h3>
            <p>{t(lang, "contact.softwareDescription")}</p>
          </div>
          <div class="work-path-actions">
            <a href={SITE.upwork} target="_blank" rel="noopener noreferrer" class="work-path-primary">
              {t(lang, "contact.upwork")} <span aria-hidden="true">&nearr;</span>
            </a>
          </div>
          <div class="fiverr-catalog">
            <p class="fiverr-catalog-label">{t(lang, "contact.fiverrCatalog")}</p>
            <div class="fiverr-gigs">
              {SITE.fiverrGigs.map((gig) => (
                <a href={gig.url} target="_blank" rel="noopener noreferrer" class="fiverr-gig">
                  <span>{gig.title[lang]}</span>
                  <small>{t(lang, "contact.fiverrFrom")} {gig.startingPrice} <span aria-hidden="true">&nearr;</span></small>
                </a>
              ))}
            </div>
            <a href={SITE.fiverr} target="_blank" rel="noopener noreferrer" class="fiverr-profile-link">
              {t(lang, "contact.fiverrProfile")} <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </article>
        <article class="work-path work-path-lessons">
          <div class="work-path-copy">
            <span class="work-path-kicker">GUITAR LESSONS</span>
            <h3>{t(lang, "contact.lessonsTitle")}</h3>
            <p>{t(lang, "contact.lessonsDescription")}</p>
          </div>
          <div class="work-path-actions">
            <a href={SITE.superprof} target="_blank" rel="noopener noreferrer" class="work-path-primary">
              {t(lang, "contact.superprof")} <span aria-hidden="true">&nearr;</span>
            </a>
          </div>
        </article>
      </div>

      <form
        id="contact-form"
        action={`https://formsubmit.co/${SITE.email}`}
        method="POST"
        class="max-w-md mx-auto text-left space-y-4 mb-8"
      >
        <input type="hidden" name="_captcha" value="true" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_next" value={contactReturnUrl} />
        <input type="hidden" name="_subject" value="New portfolio contact message" />
        <div class="cf-honeypot" aria-hidden="true">
          <label for="cf-company">Company</label>
          <input id="cf-company" type="text" name="_honey" tabindex="-1" autocomplete="off" />
        </div>
        <div>
          <label for="cf-name" class="block text-xs font-mono font-bold uppercase tracking-widest text-accent-cyan mb-1.5">
            {t(lang, "contact.form.name")}
          </label>
          <input
            type="text"
            id="cf-name"
            name="name"
            required
            placeholder={t(lang, "contact.form.namePlaceholder")}
            class="w-full px-4 py-2.5 bg-white/5 border border-white/10 rounded-lg text-white text-sm placeholder:text-text-muted focus:outline-none focus:border-accent-cyan/50 focus:ring-1 focus:ring-accent-cyan/20 transition-colors"
          />
        </div>
        <div>
          <label for="cf-email" class="block text-xs font-mono font-bold uppercase tracking-widest text-accent-cyan mb-1.5">
            {t(lang, "contact.form.email")}
          </label>
          <input
            type="email"
            id="cf-email"
            name="email"
            required
            placeholder={t(lang, "contact.form.emailPlaceholder")}
            class="w-full px-4 py-2.5 bg-white/5 border border-white/10 rounded-lg text-white text-sm placeholder:text-text-muted focus:outline-none focus:border-accent-cyan/50 focus:ring-1 focus:ring-accent-cyan/20 transition-colors"
          />
        </div>
        <div>
          <label for="cf-message" class="block text-xs font-mono font-bold uppercase tracking-widest text-accent-cyan mb-1.5">
            {t(lang, "contact.form.message")}
          </label>
          <textarea
            id="cf-message"
            name="message"
            required
            rows="4"
            placeholder={t(lang, "contact.form.messagePlaceholder")}
            class="w-full px-4 py-2.5 bg-white/5 border border-white/10 rounded-lg text-white text-sm placeholder:text-text-muted focus:outline-none focus:border-accent-cyan/50 focus:ring-1 focus:ring-accent-cyan/20 transition-colors resize-none"
          ></textarea>
        </div>
        <button
          type="submit"
          class="btn btn-primary w-full justify-center py-3 text-sm sm:text-base"
        >
          {t(lang, "contact.form.submit")}
        </button>
        <p class="captcha-note">
          <span aria-hidden="true">&#9670;</span>
          {lang === "id"
            ? "Dilindungi reCAPTCHA. Verifikasi mungkin muncul setelah pesan dikirim."
            : "Protected by reCAPTCHA. Verification may appear after you send your message."}
        </p>
        <p id="cf-status" class="text-sm text-center hidden"></p>
      </form>

      <div class="flex items-center justify-center gap-3 text-sm text-text-muted">
        <span>{t(lang, "contact.form.or")}</span>
        <a href={`mailto:${SITE.email}`} class="text-accent-cyan hover:text-accent-violet transition-colors font-medium">
          {t(lang, "contact.sendEmail")}
        </a>
        <span class="text-text-muted">&middot;</span>
        <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer" class="text-accent-cyan hover:text-accent-violet transition-colors font-medium">
          {t(lang, "contact.linkedin")}
        </a>
        <span class="text-text-muted">&middot;</span>
        <a href={SITE.github} target="_blank" rel="noopener noreferrer" class="text-accent-cyan hover:text-accent-violet transition-colors font-medium">
          {t(lang, "contact.github")}
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const status = document.getElementById("cf-status") as HTMLParagraphElement | null;
  const params = new URLSearchParams(location.search);

  if (status && params.get("sent") === "1") {
    const isIndonesian = location.pathname === "/id" || location.pathname.startsWith("/id/");
    status.textContent = isIndonesian
      ? "Pesan terkirim! Saya akan membalas dalam 24 jam."
      : "Message sent! I'll get back to you within 24 hours.";
    status.className = "text-sm text-center text-green-400";

    params.delete("sent");
    const query = params.toString();
    history.replaceState({}, "", `${location.pathname}${query ? `?${query}` : ""}#contact`);
  }
</script>

<style>
  .cf-honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .work-paths {
    display: grid;
    gap: 0.75rem;
    max-width: 48rem;
    margin: 0 auto 2.5rem;
    text-align: left;
  }

  .work-paths-label {
    margin-bottom: 0.2rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .work-path {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: center;
    padding: 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.9rem;
    background: rgba(255, 255, 255, 0.035);
  }

  .work-path-software {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .work-path-software .fiverr-catalog {
    grid-column: 1 / -1;
  }

  .work-path-software {
    border-color: color-mix(in srgb, var(--color-accent-cyan) 28%, transparent);
  }

  .work-path-lessons {
    border-color: color-mix(in srgb, var(--color-accent-violet) 24%, transparent);
  }

  .work-path-kicker {
    color: var(--color-accent-cyan);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.14em;
  }

  .work-path-lessons .work-path-kicker {
    color: var(--color-accent-violet);
  }

  .work-path h3 {
    margin-top: 0.35rem;
    color: white;
    font-size: 1.05rem;
    font-weight: 800;
  }

  .work-path-copy p {
    max-width: 34rem;
    margin-top: 0.35rem;
    color: var(--color-text-secondary);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .work-path-actions {
    display: flex;
    min-width: 12.5rem;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.45rem;
  }

  .work-path-actions a {
    color: var(--color-text-secondary);
    font-size: 0.76rem;
    font-weight: 650;
    transition: color 160ms ease;
  }

  .work-path-actions a:hover,
  .work-path-actions a:focus-visible {
    color: white;
  }

  .work-path-actions .work-path-primary {
    color: var(--color-accent-cyan);
  }

  .fiverr-catalog {
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .fiverr-catalog-label {
    margin-bottom: 0.65rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 750;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .fiverr-gigs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .fiverr-gig {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.65rem;
    background: rgba(0, 0, 0, 0.12);
    color: white;
    font-size: 0.76rem;
    font-weight: 700;
    line-height: 1.35;
    transition: border-color 160ms ease, background-color 160ms ease, transform 160ms ease;
  }

  .fiverr-gig small {
    color: var(--color-accent-cyan);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
  }

  .fiverr-gig:hover,
  .fiverr-gig:focus-visible {
    border-color: color-mix(in srgb, var(--color-accent-cyan) 42%, transparent);
    background: color-mix(in srgb, var(--color-accent-cyan) 6%, transparent);
    transform: translateY(-2px);
  }

  .fiverr-profile-link {
    display: inline-block;
    margin-top: 0.7rem;
    color: var(--color-text-secondary);
    font-size: 0.7rem;
    font-weight: 650;
  }

  .fiverr-profile-link:hover,
  .fiverr-profile-link:focus-visible {
    color: white;
  }

  .work-path-lessons .work-path-primary {
    color: var(--color-accent-violet);
  }

  @media (max-width: 640px) {
    .work-path {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }

    .work-path-actions {
      min-width: 0;
    }

    .fiverr-gigs {
      grid-template-columns: 1fr;
    }
  }

  .captcha-note {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 0.45rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    line-height: 1.5;
    text-align: center;
  }

  .captcha-note span {
    flex: 0 0 auto;
    color: var(--color-accent-cyan);
    font-size: 0.55rem;
    transform: translateY(0.2rem);
  }
</style>
