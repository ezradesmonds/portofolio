---
import { SITE } from '../../data/site';
import TextLoop from './TextLoop';
import { publicProjects, selectedSlugs, displayName } from '../../data/studio';
const montage = selectedSlugs.map(slug => publicProjects.find(project => project.slug === slug)).filter(project => project !== undefined);
const { lang } = Astro.props as { lang: 'en' | 'id' };
const id = lang === 'id';
---
<section id="top" class="portfolio-hero" aria-labelledby="hero-heading">
  <div class="hero-topline"><span><i aria-hidden="true"></i>{id ? 'PORTOFOLIO / 2026' : 'PORTFOLIO / 2026'}</span><span>SURABAYA, INDONESIA · UTC+7</span></div>
  <h1 id="hero-heading" aria-label="Ezra Desmond"><span class="hero-name-line"><span>EZRA</span></span><span class="hero-name-line hero-name-second"><span>DESMOND</span></span></h1>
  <div class="hero-facts">
    <div class="hero-fact"><svg class="fact-location" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z"/><circle cx="12" cy="10" r="2.5"/></svg><p><strong>{id ? 'BERBASIS DI INDONESIA,' : 'BASED IN INDONESIA,'}</strong><span>SURABAYA</span></p></div>
    <div class="hero-fact"><svg class="fact-globe" viewBox="0 0 40 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><ellipse cx="20" cy="12" rx="18" ry="9"/><ellipse cx="20" cy="12" rx="10" ry="9"/><ellipse cx="20" cy="12" rx="4" ry="9"/><path d="M2 12h36M5 7h30M5 17h30"/></svg><p><strong>{id ? 'TERSEDIA UNTUK BEKERJA' : 'AVAILABLE FOR WORK'}</strong><span>{id ? 'DAN MAGANG' : 'AND INTERNSHIP'}</span></p></div>
    <div class="hero-fact"><svg class="fact-role" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m12 2 3 2 3.5.5.5 3.5 2 4-2 3-.5 3.5-3.5.5-3 2-3-2-3.5-.5L5 15l-2-3 2-4 .5-3.5L9 4Z"/><path d="m8 12 2.5 2.5L16 9"/></svg><p><span>{id ? 'MAHASISWA INFORMATIKA' : 'INFORMATICS STUDENT'}</span><strong>AI & FULL-STACK BUILDER</strong></p></div>
  </div>
  <div class="hero-introduction hero-loop-introduction"><TextLoop client:load text={id ? 'Saya membangun produk dan sistem yang membantu orang bergerak dari proses rumit menuju tindakan yang jelas.' : 'I build products and systems that move people from messy processes to clear action.'} shape="wave" curviness={18} fontSize={30} fontWeight={600} letterSpacing={0} uppercase={false} speed={55} ribbonWidth={64} ribbonColor="#d99b75" color="#0b0d0d" pauseOnHover={false}/><a href="#work" aria-label={id ? 'Gulir ke karya pilihan' : 'Scroll to selected work'}>↓</a></div>
  <div class="hero-film" aria-hidden="true"><div class="film-frame project-montage"><div class="montage-title">DIGITAL PRODUCTS.<br/><em>REAL SYSTEMS.</em></div><div class="montage-wall">{montage.map(project => <img src={project.screenshot} alt="" width="800" height="500" loading="lazy" decoding="async"/>)}</div><img class="montage-mark" src="/ezra-logo.png" alt="" width="80" height="80"/></div><span>01 / WORK IN THE WILD</span><span>EZRA DESMOND © 2026</span></div>
  <a class="hero-cv" href={SITE.cvUrl} download>{id ? 'Unduh CV' : 'Download CV'} ↗</a>
</section>
