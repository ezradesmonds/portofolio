---
import type { Project } from '../../types';
import { capabilities } from '../../data/capabilities';
import { localizeCapabilities } from '../../i18n/content';
import { displayName, selectedSlugs } from '../../data/studio';
import { SITE } from '../../data/site';
const { lang, all, prefix } = Astro.props as { lang: 'en' | 'id'; all: Project[]; prefix: string };
const id = lang === 'id';
const groups = localizeCapabilities(capabilities, lang);
const archive = all.filter(project => !selectedSlugs.includes(project.slug));
---
<section id="archive" class="portfolio-archive" aria-labelledby="archive-heading">
  <header class="chapter-intro"><span class="chapter-index">03 / {id ? 'TEKNOLOGI' : 'TECHNOLOGY'} <span>{all.length} {id ? 'PROYEK PUBLIK' : 'PUBLIC PROJECTS'}</span></span><div><h2 id="archive-heading"><>Stack &amp;<br/><em>Tools.</em></></h2><p>{id ? 'Teknologi dan alat yang saya gunakan untuk membangun antarmuka, backend, alur data, dan produk AI.' : 'The technologies and tools I use to build interfaces, backends, data flows, and AI products.'}</p></div></header>
  <div class="capability-ledger">{groups.map((group, index) => <details open={index === 0}><summary><span>0{index + 1}</span><h3>{group.name}</h3><b aria-hidden="true">＋</b></summary><p>{group.items.map(item => item.name).join('  /  ')}</p></details>)}</div>
  <div class="archive-head"><span class="chapter-index">04 / {id ? 'ARSIP' : 'ARCHIVE'} <span>{String(archive.length).padStart(2, '0')} {id ? 'KARYA LAIN' : 'MORE PROJECTS'}</span></span><h3>{id ? 'Terus membuat.' : 'Always building.'}</h3><p>{id ? 'Proyek lain, eksperimen, dan pekerjaan akademik yang tersedia sebagai studi kasus.' : 'Other projects, experiments, and academic work available as case studies.'}</p></div>
  <div class="archive-list">{archive.map((project, index) => <a class="archive-row" href={`${prefix}/work/${project.slug}/`}><span>{String(index + 6).padStart(2, '0')}</span><strong>{displayName(project)}</strong><span>{project.category}</span><span class="archive-arrow" aria-hidden="true">↗</span><img src={project.screenshot} alt="" width="500" height="315" loading="lazy" decoding="async"/></a>)}</div>
</section>
<section id="contact" class="portfolio-contact" aria-labelledby="contact-heading"><div class="contact-intro"><span class="chapter-index">05 / {id ? 'KONTAK' : 'CONTACT'} <span>SURABAYA · UTC+7</span></span><h2 id="contact-heading">{id ? <>MARI BANGUN<br/>SESUATU YANG<br/><em>BERGUNA.</em></> : <>LET'S BUILD<br/>SOMETHING<br/><em>USEFUL.</em></>}</h2><p>{id ? 'Terbuka untuk magang, kolaborasi, dan pekerjaan product engineering yang berangkat dari masalah nyata.' : 'Open to internships, collaborations, and product engineering work grounded in a real problem.'}</p><a class="contact-mail" href={`mailto:${SITE.email}`}>{SITE.email} ↗</a></div><div class="contact-aside"><div class="contact-portrait" data-pixel-portrait><canvas width="24" height="30" aria-hidden="true"></canvas><img src="/images/profile/ezra-portrait-editorial.webp" alt="" width="640" height="640" loading="lazy"/></div><div class="contact-links"><button type="button" data-copy-email={SITE.email} data-success={id ? 'Email tersalin' : 'Email copied'} data-failure={id ? 'Gagal menyalin; gunakan tautan email.' : 'Copy failed; use the email link.'}>{id ? 'Salin email' : 'Copy email'} ↗</button><a href={SITE.cvUrl} download>{id ? 'Unduh CV' : 'Download CV'} ↗</a><a href={SITE.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href={SITE.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a><a href={SITE.upwork} target="_blank" rel="noopener noreferrer">Upwork ↗</a><a href={SITE.fiverr} target="_blank" rel="noopener noreferrer">Fiverr ↗</a></div><p data-copy-feedback role="status" aria-live="polite"></p></div></section>
<footer class="portfolio-footer"><span>EZRA DESMOND SUTANTO © 2026</span><a href="#top">{id ? 'Kembali ke atas' : 'Back to top'} ↑</a></footer>
