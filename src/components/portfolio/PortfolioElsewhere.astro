---
import type { Project } from '../../types';
import { capabilities } from '../../data/capabilities';
import { localizeCapabilities } from '../../i18n/content';
import { displayName, selectedSlugs, deploymentLabel, projectCardCopy } from '../../data/studio';
import { SITE } from '../../data/site';
import PortfolioGallery from './PortfolioGallery.astro';
const { lang, all, prefix } = Astro.props as { lang: 'en' | 'id'; all: Project[]; prefix: string };
const id = lang === 'id';
const groups = localizeCapabilities(capabilities, lang);
const archive = all.filter(project => !selectedSlugs.includes(project.slug));
const stackExamples = [
  [{ slug: 'akun-ai', label: 'Next.js · Akun.AI' }, { slug: 'rekapflow', label: 'React · RekapFlow' }],
  [{ slug: 'wgg-2026-realtime-voting-game', label: 'Laravel · WGG' }, { slug: 'akun-ai', label: 'Supabase · Akun.AI' }],
  [{ slug: 'tailor-cooperative-system', label: 'Python / ML · SAKTI' }, { slug: 'akun-ai', label: 'LLM · Akun.AI' }],
];
const neutralPaths: Record<string, string> = { css3: 'M3 4h18v13H3zM8 21h8m-4-4v4', react: 'M3 4h7v7H3zM14 4h7v7h-7zM3 15h7v7H3zM14 15h7v7h-7z', postgresql: 'M4 5c0-4 16-4 16 0v14c0 4-16 4-16 0V5Zm0 0c0 4 16 4 16 0M4 12c0 4 16 4 16 0', auth0: 'm12 2 9 4v6c0 5-9 10-9 10S3 17 3 12V6l9-4Zm-4 10 3 3 5-6', supabase: 'm12 2 9 4v6c0 5-9 10-9 10S3 17 3 12V6l9-4Zm-4 10 3 3 5-6', pandas: 'M4 20V9m8 11V3m8 17v-7', googlecloud: 'M3 7V3h4m10 0h4v4M3 17v4h4m10 0h4v-4M7 8h10M7 12h10M7 16h6', githubactions: 'm9 3 12 9-12 9V3ZM3 3v18', scikitlearn: 'M5 5h14v14H5zM9 9h6v6H9zM9 1v4m6-4v4M9 19v4m6-4v4M1 9h4m-4 6h4m14-6h4m-4 6h4', openai: 'M5 5h14v14H5zM9 9h6v6H9zM9 1v4m6-4v4M9 19v4m6-4v4M1 9h4m-4 6h4m14-6h4m-4 6h4' };
const logoNames = new Set(['TypeScript', 'JavaScript', 'React', 'Next.js', 'Astro', 'Tailwind CSS', 'Laravel', 'PHP', 'Supabase', 'PostgreSQL', 'Python', 'OpenRouter', 'Google Gemini integration', 'Git', 'GitHub', 'Docker', 'Vercel', 'Java', 'C++', 'R']);
---
<section id="archive" class="portfolio-archive" aria-labelledby="archive-heading">
  <header class="chapter-intro"><span class="chapter-index">03 / {id ? 'TEKNOLOGI' : 'TECHNOLOGY'} <span>{all.length} {id ? 'PROYEK PUBLIK' : 'PUBLIC PROJECTS'}</span></span><div><h2 id="archive-heading"><>Stack &amp;<br/><em>Tools.</em></></h2><p>{id ? 'Alat yang saya gunakan dalam proyek web, data, dan AI.' : 'Tools I use in web, data, and AI projects.'}</p></div></header>
  <div class="stack-groups" data-stack-tools>{groups.map((group, index) => <section class="stack-group" aria-labelledby={`stack-group-${index}`}><h3 id={`stack-group-${index}`}>{group.name}</h3><ul class="stack-grid">{group.items.map((item, itemIndex) => <li class="stack-item" style={`--float-duration:${5 + itemIndex % 3}s;--float-delay:-${itemIndex * .7}s`}><span class="stack-icon" aria-hidden="true"><span class="stack-icon-float">{logoNames.has(capabilities[index].items[itemIndex].name) ? <img src={`/assets/stack/${item.icon}.svg`} width="40" height="40" alt="" loading="lazy" decoding="async"/> : <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d={neutralPaths[item.icon ?? ""] ?? "m8 5-6 7 6 7m8-14 6 7-6 7m-3-16-2 18"}/></svg>}</span></span><span>{item.name}</span></li>)}</ul>{stackExamples[index]&&<div class="stack-evidence"><span>{id?'Digunakan di:':'Used in:'}</span>{stackExamples[index].map(example=><a href={`${prefix}/work/${example.slug}/`}>{example.label} ↗</a>)}</div>}</section>)}</div>
  <div class="archive-head" id="other-projects"><span class="chapter-index">04 / {id ? 'ARSIP' : 'ARCHIVE'} <span>{String(archive.length).padStart(2, '0')} {id ? 'KARYA LAIN' : 'MORE PROJECTS'}</span></span><h3>{id ? 'Proyek lainnya.' : 'Other projects.'}</h3><p>{id ? 'Jelajahi proyek lain dan eksperimen saya.' : 'Explore more of my projects and experiments.'}</p></div>
  <div class="archive-list">{archive.map((project, index) => <a class="archive-row" href={`${prefix}/work/${project.slug}/`}><span>{String(index + selectedSlugs.length + 1).padStart(2, '0')}</span><strong>{displayName(project)}{deploymentLabel(project, lang) && <small class="project-deployment">{deploymentLabel(project, lang)}</small>}</strong><span>{projectCardCopy(project,lang).category}</span><span class="archive-arrow" aria-hidden="true">↗</span><img src={project.screenshot} alt="" width="500" height="315" loading="lazy" decoding="async"/></a>)}</div>
</section>
<PortfolioGallery lang={lang}/>
<section id="contact" class="portfolio-contact" aria-labelledby="contact-heading"><div class="contact-intro"><span class="chapter-index">05 / {id ? 'KONTAK' : 'CONTACT'}</span><h2 id="contact-heading">{id ? <>MARI BEKERJA<br/><em>BERSAMA.</em></> : <>LET'S WORK<br/><em>TOGETHER.</em></>}</h2><p>{id ? 'Ada lowongan magang atau ide proyek? Mari ngobrol.' : 'Hiring an intern or have a project in mind? Let’s talk.'}</p><a class="contact-mail" href={`mailto:${SITE.email}`}>{SITE.email} ↗</a></div><div class="contact-aside"><img class="contact-certificate" src="/images/profile/hackathon-team-awarding.webp" alt={id ? 'Ezra bersama kelompok saat awarding hackathon SUTD × PCU' : 'Ezra with the group at the SUTD × PCU hackathon awards'} width="1600" height="1200" loading="lazy" decoding="async"/><div class="contact-links"><button type="button" data-copy-email={SITE.email} data-success={id ? 'Email tersalin' : 'Email copied'} data-failure={id ? 'Gagal menyalin; gunakan tautan email.' : 'Copy failed; use the email link.'}>{id ? 'Salin email' : 'Copy email'} ↗</button><a href={SITE.cvUrl} download>{id ? 'Unduh CV' : 'Download CV'} ↗</a><a href={SITE.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href={SITE.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a><a href={SITE.upwork} target="_blank" rel="noopener noreferrer">Upwork ↗</a><a href={SITE.fiverr} target="_blank" rel="noopener noreferrer">Fiverr ↗</a></div><p data-copy-feedback role="status" aria-live="polite"></p></div></section>
<footer class="portfolio-footer"><span>EZRA DESMOND SUTANTO © 2026</span><a href="#top">{id ? 'Kembali ke atas' : 'Back to top'} ↑</a></footer>
