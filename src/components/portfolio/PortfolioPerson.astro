---
import { experiences } from '../../data/experience';
import { awards } from '../../data/awards';
import { localizeExperiences, localizeAwards } from '../../i18n/content';
import { SITE } from '../../data/site';
const { lang } = Astro.props as { lang: 'en' | 'id' };
const id = lang === 'id';
const history = localizeExperiences(experiences, lang);
const honors = localizeAwards(awards, lang);
---
<section id="about" class="portfolio-person" aria-labelledby="about-heading">
  <header class="chapter-intro"><span class="chapter-index">02 / {id ? 'TENTANG EZRA' : 'ABOUT EZRA'} <span>SURABAYA / ID</span></span><div><h2 id="about-heading">{id ? <>Di balik<br/><em>pekerjaan.</em></> : <>The person<br/><em>behind the work.</em></>}</h2><p>{id ? 'Saya membangun produk digital di persimpangan desain, AI, dan software engineering—mengubah alur kerja yang rumit menjadi sistem yang jelas dan berguna.' : 'I build digital products where design, AI, and software engineering meet—turning complex workflows into clear, useful systems.'}</p><p class="person-about-detail">{id ? 'Dari platform commerce dan sistem event hingga eksperimen machine learning, saya menghubungkan antarmuka, backend, dan data untuk menjawab kebutuhan nyata.' : 'From commerce platforms and event systems to machine-learning experiments, I connect interfaces, backends, and data around real needs.'}</p><p class="person-about-detail">{id ? 'Di luar membangun produk, saya mengeksplorasi kreativitas melalui musik dan proyek kolaboratif—membawa rasa ingin tahu yang sama ke setiap karya.' : 'Beyond building products, I explore creativity through music and collaborative projects—bringing the same curiosity to every piece of work.'}</p></div></header>
  <div class="person-layout"><div class="person-portrait"><img src="/images/profile/ezra-portrait-editorial.webp" alt="Portrait of Ezra Desmond Sutanto" width="1000" height="1000" loading="lazy"/><div><span>EZRA DESMOND SUTANTO</span><span>INFORMATICS · GPA 3.76 / 4.00</span></div><p>{id ? 'Saya bekerja di persimpangan software engineering, AI, dan keputusan produk—dari kebutuhan pengguna sampai sistem yang bisa dijalankan.' : 'I work where software engineering, AI, and product decisions meet—from user needs to systems that can actually run.'}</p><a href={SITE.cvUrl} download>{id ? 'Unduh Resume' : 'Download Resume'} ↗</a></div>
    <div class="person-record" id="experience"><h3>{id ? 'Pengalaman & pendidikan' : 'Experience & education'}</h3>{history.map((entry, index) => <details class="experience-entry" open={index === 0}><summary><span>{entry.period}</span><strong>{entry.organization}</strong><small>{entry.role}</small><b aria-hidden="true">＋</b></summary><div class="experience-body"><p>{entry.description}</p><ul>{entry.highlights.map(highlight => <li>{highlight}</li>)}</ul></div></details>)}<details class="experience-entry"><summary><span>2024 — {id ? 'sekarang' : 'present'}</span><strong>Petra Christian University</strong><small>{id ? 'Informatika · GPA 3.76 / 4.00' : 'Informatics · GPA 3.76 / 4.00'}</small><b aria-hidden="true">＋</b></summary><div class="experience-body"><p>{id ? 'Fondasi pemrograman, data, pengembangan aplikasi, dan proyek kolaboratif.' : 'Foundations in programming, data, application development, and collaborative projects.'}</p></div></details></div></div>
  <div class="awards-block"><div><span class="chapter-index">{id ? 'PENGAKUAN' : 'RECOGNITION'}</span><h3>{id ? <>Hasil kerja,<br/>diakui.</> : <>Work,<br/>recognized.</>}</h3><p>{id ? 'Pengakuan teknik yang utama, lalu pencapaian kreatif dan akademik lain yang membentuk cara saya bekerja.' : 'A leading engineering result, with creative and academic achievements that also shape how I work.'}</p></div><div class="award-list">
    {honors[0] && <div class="award-spotlight"><span>{honors[0].year} / {id ? 'PENGHARGAAN UTAMA' : 'FEATURED AWARD'}</span><strong>{honors[0].title}</strong><h4>{honors[0].event}</h4><p>{honors[0].description}</p></div>}
    {honors.slice(1).map(award => <details><summary><span>{award.year}</span><strong>{award.title}</strong><span>{award.event}</span><b aria-hidden="true">↗</b></summary><p>{award.description}</p></details>)}
  </div></div>
</section>
