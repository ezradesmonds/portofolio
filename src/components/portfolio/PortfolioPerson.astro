---
import { experiences } from '../../data/experience';
import { awards } from '../../data/awards';
import { localizeExperiences, localizeAwards } from '../../i18n/content';
import { SITE } from '../../data/site';
const { lang } = Astro.props as { lang: 'en' | 'id' };
const id = lang === 'id';
const history = localizeExperiences(experiences, lang);
const honors = localizeAwards(awards, lang);
---
<section id="about" class="portfolio-person" aria-labelledby="about-heading">
  <div class="person-introduction">
    <h2 id="about-heading" class="person-title">{id ? <>SOSOK DI BALIK<br/>KARYANYA.</> : <>THE PERSON<br/>BEHIND THE WORK.</>}</h2>
    <div class="person-portrait"><img src="/images/profile/ezra-portrait-editorial.webp" alt={id ? 'Portrait Ezra Desmond' : 'Portrait of Ezra Desmond'} width="640" height="640" loading="lazy" decoding="async"/></div>
    <div class="person-biography">
      <h3>{id ? 'Saya bekerja di persimpangan software engineering, AI, dan keputusan produk—dari kebutuhan pengguna sampai sistem yang bisa dijalankan.' : 'I work where software engineering, AI, and product decisions meet—from user needs to systems that can actually run.'}</h3>
      <p>{id ? 'Mahasiswa Informatika di Petra Christian University. Saya belajar paling banyak saat sistem harus bergerak dari ide menuju penggunaan nyata.' : 'An Informatics student at Petra Christian University. I learn most when a system has to move from an idea into real use.'}</p>
      <p>Petra Christian University · Informatics · GPA 3.76 / 4.00</p>
      <a class="person-resume" href={SITE.cvUrl} download>{id ? 'UNDUH CV' : 'DOWNLOAD RESUME'} ↗</a>
    </div>
  </div>
  <div class="person-layout"><h3 class="person-record-title">{id ? <>PENGALAMAN<br/>& PENDIDIKAN</> : <>EXPERIENCE<br/>& EDUCATION</>}</h3><div class="person-record" id="experience">{history.map((entry, index) => <details class="experience-entry" open={index === 0}><summary><span>{entry.period}</span><strong>{entry.organization}</strong><small>{entry.role}</small><b aria-hidden="true">＋</b></summary><div class="experience-body"><p>{entry.description}</p><ul>{entry.highlights.map(highlight => <li>{highlight}</li>)}</ul></div></details>)}<details class="experience-entry"><summary><span>2024 — {id ? 'sekarang' : 'present'}</span><strong>Petra Christian University</strong><small>{id ? 'Informatika · GPA 3.76 / 4.00' : 'Informatics · GPA 3.76 / 4.00'}</small><b aria-hidden="true">＋</b></summary><div class="experience-body"><p>{id ? 'Fondasi pemrograman, data, pengembangan aplikasi, dan proyek kolaboratif.' : 'Foundations in programming, data, application development, and collaborative projects.'}</p></div></details></div></div>
  <div class="awards-block"><div><span class="chapter-index">{id ? 'PENGAKUAN' : 'RECOGNITION'}</span><h3>{id ? <>Hasil kerja,<br/>diakui.</> : <>Work,<br/>recognized.</>}</h3><p>{id ? 'Pengakuan teknik yang utama, lalu pencapaian kreatif dan akademik lain yang membentuk cara saya bekerja.' : 'A leading engineering result, with creative and academic achievements that also shape how I work.'}</p></div><div class="award-list">
    {honors[0] && <div class="award-spotlight"><span>{honors[0].year} / {id ? 'PENGHARGAAN UTAMA' : 'FEATURED AWARD'}</span><strong>{honors[0].title}</strong><h4>{honors[0].event}</h4><p>{honors[0].description}</p></div>}
    {honors.slice(1).map(award => <details><summary><span>{award.year}</span><strong>{award.title}</strong><span>{award.event}</span><b aria-hidden="true">↗</b></summary><p>{award.description}</p></details>)}
  </div></div>
</section>
