---
import { experiences } from '../../data/experience';
import { awards } from '../../data/awards';
import { localizeExperiences, localizeAwards } from '../../i18n/content';
import { SITE } from '../../data/site';
import CursorGrid from './CursorGrid';
import { publicProjects, selectedSlugs } from '../../data/studio';
const { lang } = Astro.props as { lang: 'en' | 'id' };
const id = lang === 'id';
const history = localizeExperiences(experiences, lang);
const honors = localizeAwards(awards, lang);
const showcase = selectedSlugs.map(slug => publicProjects.find(project => project.slug === slug)).filter(project => project !== undefined);
const stats = [
  { value: publicProjects.length, label: id ? 'Proyek publik' : 'Public projects', decimals: 0, suffix: '' },
  { value: showcase.length, label: id ? 'Studi kasus pilihan' : 'Selected case studies', decimals: 0, suffix: '' },
  { value: 3.76, label: 'GPA / 4.00', decimals: 2, suffix: '' },
  { value: 2, label: id ? 'Juara / SUTD × PCU Hackathon' : 'SUTD × PCU Hackathon', decimals: 0, suffix: id ? '' : 'nd' },
];
---
<section id="about" class="portfolio-person" aria-labelledby="about-heading">
  <header class="chapter-intro person-grid-intro"><CursorGrid client:visible color="#965335" cellSize={70} radius={140} maxOpacity={.5} clickPulse={true}/><span class="chapter-index">02 / {id ? 'TENTANG EZRA' : 'ABOUT EZRA'} <span>SURABAYA / ID</span></span><div><h2 id="about-heading">{id ? <>Di balik karya,<br/><em class="person-handle">@ezradesmonds</em></> : <>Behind the work,<br/><em class="person-handle">@ezradesmonds</em></>}</h2><p>{id ? 'Mahasiswa Informatika di Petra Christian University, Surabaya. Senang memecahkan masalah lewat software.' : 'Informatics student at Petra Christian University, Surabaya. I enjoy solving problems with software.'}</p><p class="person-about-detail">{id ? 'Dari toko online hingga sistem event, saya menghubungkan antarmuka, backend, dan data.' : 'From online stores to event systems, I connect interfaces, backends, and data.'}</p><p class="person-about-detail">{id ? 'Di luar coding, saya bermain musik.' : 'Outside coding, I make music.'}</p></div></header>
  <div class="person-stats" aria-label={id ? 'Portfolio dalam angka' : 'Portfolio in numbers'}>{stats.map(stat => <div><strong><span data-count-to={stat.value} data-count-decimals={stat.decimals}>{stat.value.toFixed(stat.decimals)}</span><small>{stat.suffix}</small></strong><span>{stat.label}</span></div>)}</div>
  <div class="person-layout"><div class="person-portrait"><img src="/images/profile/ezra-portrait-editorial.webp" alt="Portrait of Ezra Desmond Sutanto" width="1000" height="1000" loading="lazy"/><div><span>EZRA DESMOND SUTANTO</span><span>INFORMATICS · GPA 3.76 / 4.00</span></div><p>{id ? 'Terbuka untuk magang dan proyek freelance.' : 'Open to internships and freelance projects.'}</p><a href={SITE.cvUrl} download>{id ? 'Unduh CV' : 'Download CV'} ↗</a></div>
    <div class="person-record" id="experience"><h3>{id ? 'Pengalaman' : 'Experience'}</h3>{history.map((entry, index) => <details class="experience-entry" open={index === 0}><summary><span>{entry.period}</span><strong>{entry.organization}</strong><small>{entry.role}</small><b aria-hidden="true">＋</b></summary><div class="experience-body"><p>{entry.description}</p><ul>{entry.highlights.map(highlight => <li>{highlight}</li>)}</ul></div></details>)}<details class="experience-entry"><summary><span>2024 — {id ? 'sekarang' : 'present'}</span><strong>Petra Christian University</strong><small>{id ? 'Informatika · GPA 3.76 / 4.00' : 'Informatics · GPA 3.76 / 4.00'}</small><b aria-hidden="true">＋</b></summary><div class="experience-body"><p>{id ? 'Fondasi pemrograman, data, pengembangan aplikasi, dan proyek kolaboratif.' : 'Foundations in programming, data, application development, and collaborative projects.'}</p></div></details>{honors[0] && <div class="award-spotlight journey-award"><span>{honors[0].year} / {id ? 'PENGHARGAAN TEKNIK' : 'ENGINEERING AWARD'}</span><strong>{honors[0].title}</strong><h4>{honors[0].event}</h4><p>{honors[0].description}</p></div>}
<details class="other-awards"><summary>{id ? 'Lihat penghargaan lainnya' : 'Other awards'} <span aria-hidden="true">＋</span></summary><div class="award-list">{honors.slice(1).map(award => <details><summary><span>{award.year}</span><strong>{award.title}</strong><span>{award.event}</span><b aria-hidden="true">↗</b></summary><p>{award.description}</p></details>)}</div></details></div></div>
</section>
