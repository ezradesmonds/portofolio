---
import { experiences } from '../../data/experience';
import { awards } from '../../data/awards';
import { localizeExperiences, localizeAwards } from '../../i18n/content';
import { SITE } from '../../data/site';
import { publicProjects, selectedSlugs, displayName } from '../../data/studio';
const { lang } = Astro.props as { lang: 'en' | 'id' };
const id = lang === 'id';
const history = localizeExperiences(experiences, lang);
const honors = localizeAwards(awards, lang);
const showcase = selectedSlugs.map(slug => publicProjects.find(project => project.slug === slug)).filter(project => project !== undefined);
const gallery = publicProjects.filter(project => project.screenshot);
const stats = [
  { value: publicProjects.length, label: id ? 'Proyek publik' : 'Public projects', decimals: 0, suffix: '' },
  { value: showcase.length, label: id ? 'Studi kasus pilihan' : 'Selected case studies', decimals: 0, suffix: '' },
  { value: 3.76, label: 'GPA / 4.00', decimals: 2, suffix: '' },
  { value: 2, label: id ? 'Juara / SUTD × PCU Hackathon' : 'SUTD × PCU Hackathon', decimals: 0, suffix: id ? '' : 'nd' },
];
---
<section id="about" class="portfolio-person" aria-labelledby="about-heading">
  <header class="chapter-intro"><span class="chapter-index">02 / {id ? 'TENTANG EZRA' : 'ABOUT EZRA'} <span>SURABAYA / ID</span></span><div><h2 id="about-heading">{id ? <>Di balik karya,<br/><em class="person-handle">@ezradesmonds</em></> : <>Behind the work,<br/><em class="person-handle">@ezradesmonds</em></>}</h2><p>{id ? 'Saya membangun produk digital di persimpangan desain, AI, dan software engineering—mengubah alur kerja yang rumit menjadi sistem yang jelas dan berguna.' : 'I build digital products where design, AI, and software engineering meet—turning complex workflows into clear, useful systems.'}</p><p class="person-about-detail">{id ? 'Dari platform commerce dan sistem event hingga eksperimen machine learning, saya menghubungkan antarmuka, backend, dan data untuk menjawab kebutuhan nyata.' : 'From commerce platforms and event systems to machine-learning experiments, I connect interfaces, backends, and data around real needs.'}</p><p class="person-about-detail">{id ? 'Di luar membangun produk, saya mengeksplorasi kreativitas melalui musik dan proyek kolaboratif—membawa rasa ingin tahu yang sama ke setiap karya.' : 'Beyond building products, I explore creativity through music and collaborative projects—bringing the same curiosity to every piece of work.'}</p></div></header>
  <div class="person-stats" aria-label={id ? 'Portfolio dalam angka' : 'Portfolio in numbers'}>{stats.map(stat => <div><strong><span data-count-to={stat.value} data-count-decimals={stat.decimals}>{stat.value.toFixed(stat.decimals)}</span><small>{stat.suffix}</small></strong><span>{stat.label}</span></div>)}</div>
  <div class="person-layout"><div class="person-portrait"><img src="/images/profile/ezra-portrait-editorial.webp" alt="Portrait of Ezra Desmond Sutanto" width="1000" height="1000" loading="lazy"/><div><span>EZRA DESMOND SUTANTO</span><span>INFORMATICS · GPA 3.76 / 4.00</span></div><p>{id ? 'Saya bekerja di persimpangan software engineering, AI, dan keputusan produk—dari kebutuhan pengguna sampai sistem yang bisa dijalankan.' : 'I work where software engineering, AI, and product decisions meet—from user needs to systems that can actually run.'}</p><a href={SITE.cvUrl} download>{id ? 'Unduh Resume' : 'Download Resume'} ↗</a></div>
    <div class="person-record" id="experience"><h3>{id ? 'Pengalaman & perjalanan' : 'Experience & journey'}</h3>{history.map((entry, index) => <details class="experience-entry" open={index === 0}><summary><span>{entry.period}</span><strong>{entry.organization}</strong><small>{entry.role}</small><b aria-hidden="true">＋</b></summary><div class="experience-body"><p>{entry.description}</p><ul>{entry.highlights.map(highlight => <li>{highlight}</li>)}</ul></div></details>)}<details class="experience-entry"><summary><span>2024 — {id ? 'sekarang' : 'present'}</span><strong>Petra Christian University</strong><small>{id ? 'Informatika · GPA 3.76 / 4.00' : 'Informatics · GPA 3.76 / 4.00'}</small><b aria-hidden="true">＋</b></summary><div class="experience-body"><p>{id ? 'Fondasi pemrograman, data, pengembangan aplikasi, dan proyek kolaboratif.' : 'Foundations in programming, data, application development, and collaborative projects.'}</p></div></details>{honors[0] && <div class="award-spotlight journey-award"><span>{honors[0].year} / {id ? 'PENGHARGAAN TEKNIK' : 'ENGINEERING AWARD'}</span><strong>{honors[0].title}</strong><h4>{honors[0].event}</h4><p>{honors[0].description}</p></div>}
<details class="other-awards"><summary>{id ? 'Lihat penghargaan lainnya' : 'Other awards'} <span aria-hidden="true">＋</span></summary><div class="award-list">{honors.slice(1).map(award => <details><summary><span>{award.year}</span><strong>{award.title}</strong><span>{award.event}</span><b aria-hidden="true">↗</b></summary><p>{award.description}</p></details>)}</div></details></div></div>
  <section class="journey-showcase" aria-label={id ? 'Galeri proyek' : 'Project gallery'}>
    <div class="journey-gallery" data-project-gallery data-lenis-prevent>
      <div class="journey-gallery-heading"><span>{id ? 'GALERI PROYEK' : 'PROJECT GALLERY'}</span><span>{gallery.length} {id ? 'PROYEK' : 'PROJECTS'}</span></div>
      <div class="journey-gallery-stage">
        <canvas aria-hidden="true"></canvas>
        <div class="journey-gallery-links">{gallery.map(project => <a href={`${id ? '/id' : ''}/work/${project.slug}/`} data-gallery-card data-title={displayName(project)} aria-label={`${id ? 'Lihat studi kasus' : 'Read case study'}: ${displayName(project)}`}>
          <img src={project.screenshot} alt="" width="800" height="500" loading="eager" fetchpriority="low" decoding="async"/>
          <span>{displayName(project)}<b aria-hidden="true">↗</b></span>
        </a>)}</div>
      </div>
      <div class="journey-gallery-controls"><span>{id ? 'SCROLL ATAU GESER UNTUK JELAJAH' : 'SCROLL OR DRAG TO EXPLORE'}</span><div><button type="button" data-gallery-prev aria-label={id ? 'Proyek sebelumnya' : 'Previous project'}>←</button><button type="button" data-gallery-next aria-label={id ? 'Proyek berikutnya' : 'Next project'}>→</button><a href="#archive">{id ? 'LANJUT' : 'CONTINUE'} ↓</a></div></div>
    </div>
  </section>
</section>
