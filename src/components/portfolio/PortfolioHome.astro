---
import '../../styles/portfolio.css';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/source-sans-3';
import '@fontsource/ibm-plex-mono/latin-400.css';
import { publicProjects, selectedSlugs } from '../../data/studio';
import { localizeProjects } from '../../i18n/content';
import { SITE } from '../../data/site';
import PortfolioHero from './PortfolioHero.astro';
import PortfolioWork from './PortfolioWork.astro';
import PortfolioPerson from './PortfolioPerson.astro';
import PortfolioElsewhere from './PortfolioElsewhere.astro';
import PortfolioApproach from './PortfolioApproach.astro';

const { lang = 'en' } = Astro.props as { lang: 'en' | 'id' };
const id = lang === 'id';
const prefix = id ? '/id' : '';
const manifestoLines = id ? ['DARI IDE KE SISTEM.', 'DARI SISTEM KE PENGGUNAAN NYATA.'] : ['FROM IDEA TO SYSTEM.', 'FROM SYSTEM TO REAL USE.'];
const all = localizeProjects(publicProjects, lang);
const featured = selectedSlugs.map(slug => all.find(project => project.slug === slug)).filter((project): project is typeof all[number] => Boolean(project));
const navigation = [
  { href: '#work', label: id ? 'Karya' : 'Work' },
  { href: '#experience', label: id ? 'Pengalaman' : 'Experience' },
  { href: '#about', label: id ? 'Tentang' : 'About' },
  { href: '#contact', label: id ? 'Kontak' : 'Contact' },
];
const sectionNavigation = [
  { href: '#introduction', label: id ? 'Pengantar' : 'Introduction' },
  { href: '#approach', label: id ? 'Pendekatan' : 'Approach' },
  { href: '#work', label: id ? 'Karya' : 'Work' },
  { href: '#about', label: id ? 'Tentang' : 'About' },
  { href: '#experience', label: id ? 'Pengalaman' : 'Experience' },
  { href: '#archive', label: 'Stack & Tools' },
  { href: '#contact', label: id ? 'Kontak' : 'Contact' },
];
---
<div class="evidence-home studio-site" data-portfolio-home>
  <div class="entry-curtain" aria-hidden="true"><span class="entry-title">{['EZRA', 'DESMOND'].map((word, wordIndex) => <><span class="entry-word">{[...word].map((letter, index) => <span class="entry-letter" style={`--letter-delay: ${((index + wordIndex * 2) % 4) * 45}ms`}>{letter}</span>)}</span>{wordIndex === 0 && <span class="entry-separator"> / </span>}</>)}</span><span class="entry-caption">PORTFOLIO 2026</span></div>
  <div class="reading-line" aria-hidden="true"><span data-reading-progress></span></div>
  <header class="portfolio-header">
    <a class="portfolio-brand" href="#top" aria-label={id ? 'Ezra — kembali ke atas' : 'Ezra — back to top'}><strong>EZRA<span>.</span></strong></a>
    <nav class="desktop-links" aria-label={id ? 'Navigasi utama' : 'Main navigation'}>{navigation.map(item => <a href={item.href}>{item.label}</a>)}</nav>
    <div class="header-actions"><div class="language-switch" aria-label={id ? 'Bahasa' : 'Language'}><a href="/" aria-current={!id ? 'page' : undefined}>EN</a><span>/</span><a href="/id/" aria-current={id ? 'page' : undefined}>ID</a></div><a class="header-cv" href={SITE.cvUrl} download>CV <span aria-hidden="true">↗</span></a></div>
    <details class="mobile-navigation"><summary>{id ? 'Menu' : 'Menu'} <span aria-hidden="true">＋</span></summary><nav aria-label={id ? 'Navigasi seluler' : 'Mobile navigation'}>{navigation.map(item => <a href={item.href}>{item.label}</a>)}</nav></details>
  </header>
  <nav class="section-sidebar" data-section-sidebar inert aria-label={id ? 'Navigasi section' : 'Section navigation'}>
    {sectionNavigation.map((item, index) => <a href={item.href} aria-label={item.label}><span class="section-marker" aria-hidden="true"><i/></span><span class="section-label"><small>{String(index + 1).padStart(2, '0')}</small>{item.label}</span></a>)}
  </nav>
  <div class="portfolio-flow">
    <PortfolioHero lang={lang}/>
    <section id="introduction" class="portfolio-manifesto" aria-label={id ? 'Pengantar' : 'Introduction'}><span class="chapter-index">00 / {id ? 'PENGANTAR' : 'INTRODUCTION'}</span><p class="true-focus" data-true-focus aria-label={manifestoLines.join(' ')}>{manifestoLines.map((line, index) => <>{index > 0 && <br/>}<span class="focus-word" aria-hidden="true">{line}</span></>)}<span class="focus-frame" aria-hidden="true"><i/><i/><i/><i/></span></p><div><span>{id ? 'Mahasiswa Informatika · AI & Full-Stack Builder' : 'Informatics Student · AI & Full-Stack Builder'}</span><span>{id ? 'Saya mengerjakan produk dari pertanyaan awal hingga antarmuka, logika, dan operasi yang dapat diuji.' : 'I work across the question, the interface, the logic, and the operating reality of a product.'}</span></div></section>
    <PortfolioApproach lang={lang}/>
    <PortfolioWork lang={lang} featured={featured} prefix={prefix}/>
    <PortfolioPerson lang={lang}/>
    <PortfolioElsewhere lang={lang} all={all} prefix={prefix}/>
  </div>
  <span class="pointer-cue" aria-hidden="true" data-pointer-cue></span>
</div>
<script src="./portfolioMotion.ts"></script>
