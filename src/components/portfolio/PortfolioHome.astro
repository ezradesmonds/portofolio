---
import '../../styles/portfolio.css';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/source-sans-3';
import '@fontsource/ibm-plex-mono/latin-400.css';
import { publicProjects, selectedSlugs } from '../../data/studio';
import { localizeProjects } from '../../i18n/content';
import { SITE } from '../../data/site';
import PortfolioHero from './PortfolioHero.astro';
import PortfolioWork from './PortfolioWork.astro';
import PortfolioPerson from './PortfolioPerson.astro';
import PortfolioElsewhere from './PortfolioElsewhere.astro';
import PortfolioApproach from './PortfolioApproach.astro';

const { lang = 'en' } = Astro.props as { lang: 'en' | 'id' };
const id = lang === 'id';
const prefix = id ? '/id' : '';
const manifestoLines = id ? ['PAHAMI MASALAHNYA.', 'BANGUN SOLUSINYA.'] : ['UNDERSTAND THE PROBLEM.', 'BUILD THE SOLUTION.'];
const all = localizeProjects(publicProjects, lang);
const featured = selectedSlugs.map(slug => all.find(project => project.slug === slug)).filter((project): project is typeof all[number] => Boolean(project));
const navigation = [
  { href: '#work', label: id ? 'Karya' : 'Work', image: '/assets/case-studies/innofashion-menu-landing.webp' },
  { href: '#about', label: id ? 'Tentang' : 'About', image: '/images/profile/ezra-portrait-editorial.webp' },
  { href: '#experience', label: id ? 'Pengalaman' : 'Experience', image: '/images/profile/ezra-certificate.jpeg' },
  { href: '#contact', label: id ? 'Kontak' : 'Contact', image: '/images/profile/hackathon-team-awarding.webp' },
];
const sectionNavigation = [
  { href: '#introduction', label: id ? 'Pendekatan' : 'Approach' },
  { href: '#approach', label: id ? 'Pendekatan' : 'Approach' },
  { href: '#work', label: id ? 'Karya' : 'Work' },
  { href: '#about', label: id ? 'Tentang' : 'About' },
  { href: '#experience', label: id ? 'Pengalaman' : 'Experience' },
  { href: '#archive', label: 'Stack & Tools' },
  { href: '#contact', label: id ? 'Kontak' : 'Contact' },
];
---
<div class="evidence-home studio-site" data-portfolio-home>
  <div class="entry-curtain" aria-hidden="true"><span class="entry-title">{['EZRA', 'DESMOND'].map((word, wordIndex) => <><span class="entry-word">{[...word].map((letter, index) => <span class="entry-letter" style={`--letter-delay: ${((index + wordIndex * 2) % 4) * 45}ms`}>{letter}</span>)}</span>{wordIndex === 0 && <span class="entry-separator"> / </span>}</>)}</span><span class="entry-caption">PORTFOLIO 2026</span></div>
  <div class="reading-line" aria-hidden="true"><span data-reading-progress></span></div>
  <header class="portfolio-header">
    <a class="portfolio-brand" href="#top" aria-label={id ? 'Ezra — kembali ke atas' : 'Ezra — back to top'}><img src="/ezra-logo-clear-v2.png" alt="" width="40" height="40"/><strong>EZRA<span>.</span></strong></a>
    <button class="nav-toggle" type="button" data-open-menu aria-label={id ? 'Buka menu' : 'Open menu'} aria-haspopup="dialog" aria-controls="portfolio-menu" aria-expanded="false"><span class="menu-dots" aria-hidden="true"><i/><i/><i/><i/></span></button>
    <a class="nav-contact" href="#contact">{id ? 'HUBUNGI SAYA' : 'CONTACT ME'}</a>
  </header>
  <dialog id="portfolio-menu" class="portfolio-menu" aria-label={id ? 'Menu navigasi' : 'Navigation menu'}>
    <div class="menu-header"><a class="menu-logo" href="#top" aria-label="Ezra"><img src="/ezra-logo-clear-v2.png" alt="" width="40" height="40"/></a><button type="button" class="nav-toggle menu-close" data-close-menu aria-label={id ? 'Tutup menu' : 'Close menu'}><span aria-hidden="true">×</span></button><a class="nav-contact" href="#contact">{id ? 'HUBUNGI SAYA' : 'CONTACT ME'}</a></div>
    <nav class="menu-links" aria-label={id ? 'Navigasi utama' : 'Main navigation'}>{navigation.map((item,index) => <a href={item.href} aria-label={item.label} style={`--menu-index: ${index}`}>
      <span class="menu-label">{item.label}</span>
      <span class="menu-flow" aria-hidden="true"><span class="menu-flow-track">{[0,1].map(() => <span class="menu-flow-group">{[0,1,2].map(() => <><span>{item.label}</span><img src={item.image} alt="" width="240" height="120" loading="lazy" decoding="async"/></>)}</span>)}</span></span>
    </a>)}</nav>
    <footer class="menu-footer"><span>©2026 {id ? 'HAK CIPTA DILINDUNGI' : 'ALL RIGHTS RESERVED'}</span><div><div class="language-switch"><a href="/" aria-current={!id ? 'page' : undefined}>EN</a><span>/</span><a href="/id/" aria-current={id ? 'page' : undefined}>ID</a></div><a href={SITE.instagram} target="_blank" rel="noopener noreferrer">INSTAGRAM ↗</a><a href={SITE.linkedin} target="_blank" rel="noopener noreferrer">LINKEDIN ↗</a><a href={SITE.github} target="_blank" rel="noopener noreferrer">GITHUB ↗</a><a href={SITE.cvUrl} download>RESUME ↗</a></div></footer>
  </dialog>
  <nav class="section-sidebar" data-section-sidebar inert aria-label={id ? 'Navigasi section' : 'Section navigation'}>
    {sectionNavigation.map((item, index) => <a href={item.href} aria-label={item.label}><span class="section-marker" aria-hidden="true"><i/></span><span class="section-label"><small>{String(index + 1).padStart(2, '0')}</small>{item.label}</span></a>)}
  </nav>
  <div class="portfolio-flow">
    <PortfolioHero lang={lang}/>
    <section id="introduction" class="portfolio-manifesto" aria-label={id ? 'Pendekatan' : 'Approach'}><span class="chapter-index">00 / {id ? 'PENDEKATAN' : 'APPROACH'}</span><p class="true-focus" data-true-focus aria-label={manifestoLines.join(' ')}>{manifestoLines.map((line, index) => <>{index > 0 && <br/>}<span class="focus-word" aria-hidden="true">{line}</span></>)}<span class="focus-frame" aria-hidden="true"><i/><i/><i/><i/></span></p><div><span>{id ? 'Mahasiswa Informatika · AI & Full-Stack Builder' : 'Informatics Student · AI & Full-Stack Builder'}</span><span>{id ? 'Dari kebutuhan pengguna ke antarmuka, backend, dan pengujian.' : 'From user needs to interfaces, backends, and testing.'}</span></div></section>
    <PortfolioApproach lang={lang}/>
    <PortfolioWork lang={lang} featured={featured} prefix={prefix}/>
    <PortfolioPerson lang={lang}/>
    <PortfolioElsewhere lang={lang} all={all} prefix={prefix}/>
  </div>
  <span class="pointer-cue" aria-hidden="true" data-pointer-cue></span>
</div>
<script src="./portfolioMotion.ts"></script>
