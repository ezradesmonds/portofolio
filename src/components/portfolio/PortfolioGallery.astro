---
import { publicProjects, displayName } from '../../data/studio';
import { galleryImages } from './projectGallery';
const { lang } = Astro.props as { lang: 'en' | 'id' };
const id = lang === 'id';
const gallery = galleryImages(publicProjects).map(item => ({ ...item, title: displayName(publicProjects.find(project => project.slug === item.slug)!) }));
---
<section id="project-gallery" class="project-drift" data-project-gallery aria-labelledby="gallery-heading">
  <header class="drift-heading"><h2 id="gallery-heading">{id ? 'GALERI PROYEK' : 'PROJECT GALLERY'}</h2></header>
  <div class="drift-stage">
    <div class="drift-plane" data-drift-plane>{gallery.map(item => <a class:list={['drift-tile', { 'drift-tile-phone': item.slug === 'servisin' }]} href={`${id ? '/id' : ''}/work/${item.slug}/`} data-gallery-card aria-label={`${id ? 'Lihat studi kasus' : 'Read case study'}: ${item.title}`}>
      <img src={item.src} alt="" width="800" height="500" loading="lazy" decoding="async" draggable="false"/>
      <span>{item.title}<b aria-hidden="true">↗</b></span>
    </a>)}</div>
  </div>
</section>
