---
const { lang } = Astro.props as { lang: 'en' | 'id' };
const id = lang === 'id';
// Process artwork from the user-requested Daniel Snows reference, stored locally.
const phases = [
  { name: 'RESEARCH', image: 'research', text: id ? 'Temukan masalah yang perlu diselesaikan.' : 'Find the problem worth solving.' },
  { name: 'CREATE', image: 'create', text: id ? 'Rancang dan bangun solusinya.' : 'Design and build the solution.' },
  { name: 'LAUNCH', image: 'launch', text: id ? 'Uji, rilis, dan perbaiki dari umpan balik.' : 'Test, release, and learn from feedback.' },
];
---
<section id="approach" class="portfolio-approach" aria-label={id ? 'Tiga tahap pendekatan' : 'Three-phase approach'}>
  <div class="approach-rail" aria-hidden="true">{phases.map((_, index) => <span>0{index + 1}</span>)}</div>
  <div class="approach-grid">{phases.map((phase, index) => <article class="approach-phase"><img src={`/assets/approach/${phase.image}.avif`} alt="" width="96" height="96" loading="lazy" decoding="async"/><h3><span class="phase-number">0{index + 1} / </span>{phase.name}</h3><p>{phase.text}</p></article>)}</div>
</section>
