---
import "../../styles/global.css";
import "../../styles/studio.css";
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/source-sans-3';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource-variable/manrope';
import '@fontsource-variable/dm-sans';
import Journey from '../studio/Journey.astro';
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import EzraLoader from "./EzraLoader.astro";
import SmoothScroll from "../interactive/SmoothScroll.astro";
import CustomCursor from "../interactive/CustomCursor";
import { SITE } from "../../data/site";
import { alternateLangPath, resolveLang, t } from "../../i18n/utils";
import type { Lang } from "../../i18n/translations";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  cinematicHome?: boolean;
}

const lang: Lang = resolveLang(Astro.url.searchParams.get("lang"), Astro.url.pathname);
const cinematicHome = Astro.props.cinematicHome ?? false;

const title = Astro.props.title ?? t(lang, "seo.title");
const description = Astro.props.description ?? t(lang, "seo.description");
const image = new URL(Astro.props.image ?? "/favicon.png", SITE.url).toString();
const canonical = new URL(Astro.url.pathname, SITE.url).toString();
const hasLocalizedAlternate = !Astro.url.pathname.startsWith("/404");
const alternatePath = alternateLangPath(lang, Astro.url.pathname);
const englishUrl = new URL(lang === "en" ? Astro.url.pathname : alternatePath, SITE.url).toString();
const indonesianUrl = new URL(lang === "id" ? Astro.url.pathname : alternatePath, SITE.url).toString();
const baseStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: SITE.name,
    url: SITE.url,
    email: `mailto:${SITE.email}`,
    jobTitle: SITE.headline,
    sameAs: [SITE.github, SITE.linkedin, SITE.instagram, SITE.upwork, SITE.fiverr],
    address: {
      "@type": "PostalAddress",
      addressLocality: "Surabaya",
      addressCountry: "ID",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.name,
    url: SITE.url,
    inLanguage: lang === "id" ? "id-ID" : "en-US",
  },
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    name: title,
    url: canonical,
    description,
    mainEntity: {
      "@type": "Person",
      name: SITE.name,
      url: SITE.url,
    },
  },
];
const extraStructuredData = Astro.props.structuredData
  ? Array.isArray(Astro.props.structuredData)
    ? Astro.props.structuredData
    : [Astro.props.structuredData]
  : [];
const jsonLd = [...baseStructuredData, ...extraStructuredData];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <title>{title}</title>

    <link rel="icon" type="image/png" sizes="256x256" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    {hasLocalizedAlternate && (
      <>
        <link rel="alternate" hreflang="en" href={englishUrl} />
        <link rel="alternate" hreflang="id" href={indonesianUrl} />
        <link rel="alternate" hreflang="x-default" href={englishUrl} />
      </>
    )}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ezra Desmond Sutanto" />
    <meta property="og:locale" content={lang === "id" ? "id_ID" : "en_US"} />
    <meta property="og:locale:alternate" content={lang === "id" ? "en_US" : "id_ID"} />
    <meta property="og:image" content={image} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />


    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

  </head>
  <body class:list={[cinematicHome ? 'reference-site' : 'studio-site case-page']}>
    <a href="#main-content" class="skip-link">{t(lang, "skipLink")}</a>
    {!cinematicHome && <Journey lang={lang}/>}
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>
