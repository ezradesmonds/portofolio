---
import '../../styles/reference.css';
import '../../styles/reference-adapter.css';
import '@fontsource-variable/manrope';
import '@fontsource-variable/dm-sans';
import Mark from './Mark.astro';
import Wordmark from './Wordmark.astro';
import {publicProjects,selectedSlugs,displayName} from '../../data/studio';
import {experiences} from '../../data/experience';
import {awards} from '../../data/awards';
import {capabilities} from '../../data/capabilities';
import {localizeProjects,localizeExperiences,localizeAwards,localizeCapabilities} from '../../i18n/content';
import {SITE} from '../../data/site';
import Archive from '../studio/Archive';
import WorkflowDemo from '../studio/WorkflowDemo';
const {lang='en'}=Astro.props as {lang:'en'|'id'};
const id=lang==='id',prefix=id?'/id':'';
const all=localizeProjects(publicProjects,lang),featured=selectedSlugs.map(slug=>all.find(p=>p.slug===slug)!).filter(Boolean);
const nav=[['home',id?'Beranda':'Home'],['about',id?'Tentang saya':'About me'],['projects',id?'Proyek':'Projects'],['capabilities',id?'Kapabilitas':'Capabilities'],['archive',id?'Arsip':'Archive'],['contact',id?'Kontak':'Contact']];
const labels={work:id?'Mari berdiskusi':'Let’s work together',view:id?'Lihat karya':'View my work',available:id?'Terbuka untuk magang & proyek':'Open to internships & projects',role:'AI / Full-stack developer',body:id?'Saya membangun produk AI, sistem operasional, dan pengalaman web—dengan bukti di balik setiap proyek.':'I build AI products, operational systems, and web experiences—with evidence behind every project.',story:id?'Cerita lengkap':'The story',pause:id?'Jeda animasi':'Pause motion',resume:id?'Lanjutkan animasi':'Resume motion'};
const timeline=localizeExperiences(experiences,lang);
const year=(period:string)=>period.match(/20\d{2}/)?.[0]??'2026';
const milestones=[
 {year:'2024',title:id?'Belajar lewat membangun.':'Learning by building.',body:id?'Informatika di Petra Christian University. Proyek kuliah menjadi tempat untuk mencoba, gagal, dan memahami sistem.':'Informatics at Petra Christian University. Academic projects became a place to experiment, fail, and understand systems.',detail:id?'GPA 3.76 / 4.00. Fondasi pemrograman, data, dan pengembangan aplikasi.':'GPA 3.76 / 4.00. Foundations in programming, data, and application development.',image:all.find(p=>p.slug==='tower-defense-game')?.screenshot,tag:id?'Pendidikan':'Education'},
 {year:'2025',title:id?'Dari kode ke kerja tim.':'From code to teamwork.',body:timeline[0].description,detail:timeline[0].highlights[0],image:featured[4].screenshot,tag:'Innofashion Show 8'},
 {year:'2026',title:id?'Membuat keputusan lebih jelas.':'Making decisions clearer.',body:featured[3].description,detail:featured[3].outcome,image:featured[3].screenshot,tag:'SAKTI · GEO 2026'},
 {year:'2026',title:id?'Sistem yang dipakai saat acara.':'Systems that show up on event day.',body:featured[4].description,detail:featured[4].contribution,image:featured[4].screenshot,tag:'Innofashion / WGG'},
 {year:'2026',title:id?'Sekarang, menghubungkan semuanya.':'Now, connecting the pieces.',body:featured[0].description,detail:featured[0].outcome,image:featured[0].screenshot,tag:'Akun.AI'},
];
---
<div class="portfolio reference-portfolio motion-paused" data-reference>
 <header class="mobile-header"><a href="#home" class="wordmark">ezra</a><div class="language"><a href="/" aria-current={!id?'page':undefined}>EN</a><span>/</span><a href="/id/" aria-current={id?'page':undefined}>ID</a></div><button class="menu-button" data-menu aria-expanded="false" aria-controls="mobile-menu">Menu <span>+</span></button></header>
 <div id="mobile-menu" class="mobile-menu" hidden><nav>{nav.map(([anchor,label])=><a href={`#${anchor}`}>{label}</a>)}</nav><a class="button accent" href="#contact">{labels.work} ↗</a><button class="motion-toggle" data-reference-motion data-pause={labels.pause} data-resume={labels.resume}>{labels.pause}</button></div>
 <aside class="sidebar" aria-label={id?'Navigasi portofolio':'Portfolio navigation'}><div class="profile-panel"><div class="profile-top"><a class="wordmark" href="#home" aria-label="Ezra — home"><Wordmark/></a><a class="social-square" href={SITE.linkedin} aria-label="LinkedIn">in</a></div><p>{labels.body}</p><div class="status"><span></span>{labels.available}</div></div><div class="sidebar-traits"><div><Mark/><span>AI systems</span></div><div><Mark variant={2}/><span>Full-stack</span></div></div><div class="nav-panel"><nav>{nav.map(([anchor,label],i)=><a href={`#${anchor}`}><span class="nav-symbol" aria-hidden="true">{['⌂','◕','▰','▱','◉','↗'][i]}</span><span class="nav-label">{label}</span><span class="nav-index">0{i+1}</span></a>)}</nav></div><div class="sidebar-settings"><div class="language"><a href="/" aria-current={!id?'page':undefined}>EN</a><span>/</span><a href="/id/" aria-current={id?'page':undefined}>ID</a></div><button class="motion-toggle" data-reference-motion data-pause={labels.pause} data-resume={labels.resume} aria-label={labels.pause}>Ⅱ</button></div><a class="sidebar-email" href={`mailto:${SITE.email}`}>{SITE.email} ↗</a><a class="button accent" href="#contact">{labels.work} ↗</a></aside>
 <span id="studio"></span><section id="home" class="hero" aria-labelledby="hero-heading"><div class="hero-stage"><div class="hero-topline"><span>EZRA DESMOND SUTANTO</span><div class="language"><a href="/">EN</a><span>/</span><a href="/id/">ID</a></div><span class="status"><span></span>{labels.available}</span></div><div class="hero-name" aria-hidden="true"><Wordmark/></div>
 <div class="hero-art" role="img" aria-label={id?'Studi huruf E tiga dimensi':'Three-dimensional letter E study'}><svg viewBox="0 0 650 700" fill="none" aria-hidden="true"><path d="M180 95 305 25 575 87 532 192 368 156 350 253 505 286 480 393 329 363 301 495 482 536 448 659 151 586Z" fill="#151713"/><path d="M180 95 305 25 280 143 234 672 110 591Z" fill="#3b3e35"/><path d="m280 143 295-56-43 105-164-36-18 97 155 33-25 107-151-30-28 132 181 41-34 123-214 13Z" fill="#22251e"/><path d="m368 156 164 36-48 34-125-27Zm-39 207 151 30-46 35-114-26Zm-28 132 181 41-54 39-137-37Z" fill="#484c40"/></svg></div>
 <nav class="hero-nav" aria-label={id?'Pintasan bagian':'Section shortcuts'}><div>{nav.slice(0,3).map(([anchor,label])=><a href={`#${anchor}`}>{label}</a>)}</div><div>{nav.slice(3).map(([anchor,label])=><a href={`#${anchor}`}>{label}</a>)}</div></nav>
 <div class="hero-main"><p class="hero-role">{labels.role}</p><h1 id="hero-heading" class="hero-title">Ezra Desmond Sutanto</h1><div class="hero-actions"><a class="button accent" href="#contact">{labels.work} ↗</a><a class="button light" href="#projects">{labels.view} →</a></div></div>
 <div class="hero-skillcards" aria-hidden="true"><div class="hero-skillcard hero-skillcard-design"><Mark/><span>AI systems</span></div><div class="hero-skillcard hero-skillcard-build"><Mark variant={2}/><span>Full-stack</span></div></div>
 <div class="hero-bottom"><p>{id?'Mahasiswa Informatika. Pengembang produk. Musisi.':'Informatics student. Product builder. Musician.'}</p><a href="#about" class="scroll-cue"><span>↓</span>{id?'Gulir untuk menjelajah':'Scroll to explore'}</a><p>{labels.body}</p></div><div class="hero-bottomline"><span>BASED IN SURABAYA, INDONESIA</span><a href={SITE.cvUrl} download>DOWNLOAD CV ↗</a></div></div></section>
 <div class="main-content">
 <section id="about" class="about section"><div class="desktop-about-intro"><div class="section-heading"><p class="eyebrow">{id?'PERJALANAN SEJAUH INI':'THE PATH SO FAR'}</p><h2>{id?'Tentang saya (&)':'About me (&)'}<br/>{id?'perjalanan ini.':'my journey.'}</h2></div><p class="section-intro">{id?'Dari proyek kuliah hingga platform yang dipakai bisnis dan acara. Inilah benang merahnya.':'From academic projects to platforms used by businesses and events. Here’s how the dots connect.'}</p></div><div class="mobile-about-intro"><p class="eyebrow">{id?'TENTANG SAYA':'A LITTLE CONTEXT'}</p><h2>{id?'Belajar. Membangun.':'Learning. Building.'}<br/>{id?'Menghubungkan.':'Connecting.'}</h2></div><div class="about-layout"><img class="portrait-study" src="/images/profile/ezra-portrait.webp" alt="Ezra Desmond Sutanto" width="1000" height="1000" loading="lazy"/><div class="about-copy"><p>{labels.body}</p><div class="signature">Ezra.</div><p class="small">Petra Christian University<br/>Informatics · GPA 3.76 / 4.00</p></div></div></section>
 <section id="journey" class="journey section"><div class="journey-track"><svg class="journey-line" viewBox="0 0 900 2200" preserveAspectRatio="none" aria-hidden="true"><path class="journey-path" d="M100 0C-50 280 900 240 780 460S-50 590 110 900S890 1040 780 1350S-50 1560 110 1850S600 2020 810 2200" fill="none" stroke="currentColor" stroke-width="2"/></svg>{milestones.map((item,i)=><article class={`journey-card journey-${i}`}><div class="journey-year"><span>{item.year}</span><p>{item.tag}</p></div><h3>{item.title}</h3><p>{item.body}</p>{item.image&&<img class="milestone-image" src={item.image} alt={item.tag} width="640" height="400" loading="lazy"/>}<div class="journey-meta"><span>{item.tag}</span><details><summary>{labels.story} ↗</summary><p>{item.detail}</p></details></div><span class="journey-dot" aria-hidden="true"></span></article>)}</div><details class="full-history"><summary>{id?'Semua pengalaman & penghargaan':'All experience & achievements'} <span>+</span></summary><img class="history-portrait" src="/images/profile/ezra-portrait.webp" alt="Ezra Desmond Sutanto" width="800" height="600" loading="lazy"/>{timeline.map(entry=><details><summary>{entry.period} / {entry.organization} ↗</summary><h3>{entry.role}</h3><p>{entry.description}</p><ul>{entry.highlights.map(h=><li>{h}</li>)}</ul></details>)}<h3>{id?'Penghargaan & karya kreatif':'Awards & creative work'}</h3>{localizeAwards(awards,lang).map(a=><details><summary>{a.year} / {a.title} — {a.event} ↗</summary><p>{a.description}</p></details>)}</details></section>
 <span id="work"></span><section id="projects" class="projects section"><div class="section-heading"><p class="eyebrow">{id?'KARYA PILIHAN':'SELECTED WORK'} / 2024–2026</p><h2>{id?'Dibangun untuk':'Built for'}<br/>{id?'kebutuhan nyata.':'real needs.'}</h2></div><p class="section-intro">{id?'Lima proyek, dengan peran, keputusan, dan bukti yang bisa diperiksa.':'Five projects, with roles, decisions, and evidence you can inspect.'}</p><div class="gallery-controls"><button class="round-button prev" data-gallery-move="-1" aria-label={id?'Proyek sebelumnya':'Previous project'}>←</button><button class="round-button" data-gallery-move="1" aria-label={id?'Proyek berikutnya':'Next project'}>→</button></div><div class="project-list" tabindex="0" aria-label={id?'Galeri proyek':'Project gallery'}>{featured.map((p,i)=><article class="project"><a class="project-visual" href={`${prefix}/work/${p.slug}/`}><img src={p.screenshot} alt={p.title} width="1440" height="1000" loading="lazy"/><span class="project-badge">{p.statusLabel}</span><span class="project-view">{id?'Buka studi kasus':'Explore project'} ↗</span></a><div class="project-caption"><span class="project-number">/0{i+1}</span><div><p>{p.category}</p><h3>{displayName(p)}</h3></div><a class="round-button" href={`${prefix}/work/${p.slug}/`} aria-label={p.title}>↗</a></div></article>)}</div></section>
 <section id="capabilities" class="capabilities section"><div class="section-heading"><p class="eyebrow">{id?'KAPABILITAS':'CAPABILITIES'}</p><h2>{id?'Dari ide':'From idea'}<br/>{id?'ke implementasi.':'to implementation.'}</h2></div><p class="manifesto">{id?'Antarmuka, backend, dan integrasi AI. Terhubung untuk menyelesaikan pekerjaan yang nyata.':'Interfaces, backends, and AI integrations. Connected to get real work done.'}</p><div class="capability-list">{localizeCapabilities(capabilities,lang).map((group,i)=><details class="capability"><summary><Mark variant={i}/><h3>{group.name}</h3><span>+</span></summary><div class="capability-tools">{group.items.map(item=><div><strong>{item.name}</strong>{item.description&&<p>{item.description}</p>}</div>)}</div></details>)}</div></section>
 <section class="reference-demos section"><p class="eyebrow">{id?'COBA ALURNYA':'TRY THE WORKFLOW'}</p><h2>{id?'Tidak hanya':'Not just'}<br/>{id?'tangkapan layar.':'screenshots.'}</h2><div class="studio-site demo-inset"><WorkflowDemo kind="receipt" lang={lang} client:visible/><WorkflowDemo kind="vote" lang={lang} client:visible/></div></section>
 <section id="archive" class="section reference-archive"><p class="eyebrow">{all.length} {id?'PROYEK PUBLIK':'PUBLIC PROJECTS'}</p><h2>{id?'Masih ada':'More from'}<br/>{id?'yang lain.':'the studio.'}</h2><div class="studio-site archive-inset"><Archive items={all.filter(p=>!selectedSlugs.includes(p.slug)).map(({slug,title,category,screenshot,statusLabel})=>({slug,title,category,screenshot,statusLabel}))} lang={lang} client:visible/></div></section>
 <section class="cta section"><p class="eyebrow">{id?'IDE BERIKUTNYA':'THE NEXT IDEA'}</p><h2>{id?'Ada sesuatu':'Have something'}<br/>{id?'yang ingin dibangun?':'worth building?'}</h2><div class="cta-bottom"><Mark/><p>{id?'Ceritakan ide, masalah, atau kebutuhan timmu. Kita mulai dari sana.':'Bring the idea, the problem, or what your team needs. We can start there.'}</p><a class="button accent" href="#contact">{labels.work} ↗</a></div></section>
 <section id="contact" class="contact section"><p class="eyebrow">{id?'MARI MULAI':'LET’S MAKE IT HAPPEN'}</p><h2>{id?'Mulai dari':'Start with'}<br/>{id?'percakapan.':'a conversation.'}</h2><div class="contact-grid"><div class="contact-info"><p>{labels.available}</p><a class="contact-link" href={`mailto:${SITE.email}`}>{SITE.email} ↗</a><a class="contact-link" href={SITE.linkedin}>LinkedIn ↗</a><a class="contact-link" href={SITE.github}>GitHub ↗</a><a class="contact-link" href={SITE.instagram}>Instagram ↗</a></div><div class="reference-contact-side"><img src="/images/profile/ezra-portrait.webp" alt="Ezra Desmond Sutanto" width="600" height="400" loading="lazy"/><a class="button" href={SITE.cvUrl} download>{id?'Unduh CV':'Download CV'} ↓</a><details><summary>{id?'Jasa pengembangan & les musik':'Development services & music lessons'} +</summary><a href={SITE.fiverr}>Fiverr ↗</a><a href={SITE.upwork}>Upwork ↗</a><a href={SITE.superprof}>Superprof ↗</a>{SITE.fiverrGigs.map(g=><a href={g.url}>{g.title[lang]} ↗</a>)}</details></div></div></section>
 <footer class="footer"><div class="footer-top"><p>AI / FULL-STACK / MUSIC</p><a href="#home">{id?'Kembali ke atas':'Back to top'} ↑</a></div><a href="#home" class="footer-name" aria-label="Ezra — home">EZRA</a><div class="footer-bottom"><span>© {new Date().getFullYear()} {SITE.name}</span><button data-reference-motion data-pause={labels.pause} data-resume={labels.resume}>{labels.pause}</button><span>Surabaya, Indonesia</span></div></footer>
 </div>
</div>
<script src="./referenceController.ts"></script>
