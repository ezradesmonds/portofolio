---
import type {Project} from '../../types';
import Gallery from './Gallery';
import {artifacts,publicProjects,studioCopy,displayName} from '../../data/studio';
import {localizeProjects} from '../../i18n/content';
import SaktiCaseStudy from '../projects/SaktiCaseStudy.astro';
import ProductDiscovery from '../projects/ProductDiscovery.astro';
import { portfolioPresentation } from '../../data/portfolioPresentation';
import '../../styles/case-editorial.css';
const {project:p,lang}=Astro.props as {project:Project;lang:'en'|'id'};
const d=p.detail,c=studioCopy(lang),id=lang==='id',prefix=id?'/id':'';
const sections=id?['Ikhtisar','Keputusan','Implementasi','Hasil','Detail teknis']:['Overview','Decisions','Implementation','Results','Technical details'];
const anchors=['overview','decisions','implementation','results','technical'];
const live=p.liveLinks?.length?p.liveLinks:p.liveUrl?[{url:p.liveUrl,label:c.live}]:[];
const repos=p.githubLinks?.length?p.githubLinks:p.githubUrl?[{url:p.githubUrl,label:p.githubLabel??(p.githubIsGeneric?'GitHub profile':'GitHub')}]:[];
const related=localizeProjects(publicProjects.filter(item=>item.slug!==p.slug),lang).sort((a,b)=>Number(d?.relatedProjects?.includes(b.slug)??false)-Number(d?.relatedProjects?.includes(a.slug)??false)).slice(0,3);
const media=artifacts(p);
const aiLabels:Record<string,string>={provider:'Provider / model',dataFlow:id?'Aliran data':'Data flow',validation:id?'Validasi':'Validation',failureHandling:id?'Penanganan kegagalan':'Failure handling',limitations:id?'Batasan':'Limitations'};
const presentation=portfolioPresentation[p.slug];
---
<article class="studio-case" style={`--project-accent:${presentation?.accent??'#efae83'}`}>
  <nav class="case-site-nav" aria-label={id?'Navigasi studi kasus':'Case study navigation'}><a class="case-identity" href={`${prefix}/`}>EZRA<span>.</span> <small>DESMOND SUTANTO</small></a><div><a href={`${prefix}/#work`}>{id?'Karya':'Work'}</a><span class="case-lang"><a href={`/work/${p.slug}/`} aria-current={!id?'page':undefined}>EN</a> / <a href={`/id/work/${p.slug}/`} aria-current={id?'page':undefined}>ID</a></span></div></nav>
  <a href={`${prefix}/#work`} class="case-back">← {id?'Kembali ke karya':'Back to work'}</a>
  <header class="case-intro"><div class="case-kicker"><span class="eyebrow">{p.category}</span><span class="eyebrow">{p.statusLabel}</span></div><h1>{p.title}</h1><p class="case-lens">{presentation?.lens[lang]??p.role}</p><p>{p.description}</p><div class="case-facts"><div><span class="eyebrow">{id?'Peran':'Role'}</span><p>{p.role}</p></div><div><span class="eyebrow">{id?'Hasil & status':'Outcome & status'}</span><p>{p.outcome??p.statusLabel}</p></div></div><div class="actions"><a class="primary" href="#overview">{id?'Baca studi kasus':'Explore the case'} ↓</a>{live.map(link=><a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}{repos.map(link=><a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}</div></header>
  <div class="case-gallery"><Gallery items={media} lang={lang} priority client:load/></div>
  <nav class="case-toc" aria-label={id?'Bagian studi kasus':'Case study sections'}>{sections.map((label,i)=><a href={`#${anchors[i]}`}>{label}</a>)}</nav>
  <section id="overview" class="case-section"><span class="eyebrow">{sections[0]}</span><h2>{id?'Masalah yang dikerjakan.':'The problem to solve.'}</h2><p class="case-lead">{d?.overview??p.description}</p><div class="case-columns"><div><h3>{id?'Masalah':'Problem'}</h3><p>{p.problem}</p></div><div><h3>{id?'Pengguna':'People'}</h3><p>{p.targetUsers}</p></div></div></section>
  <section id="decisions" class="case-section"><span class="eyebrow">{sections[1]}</span><h2>{id?'Pilihan di balik antarmuka.':'The choices behind the interface.'}</h2><p>{d?.productStrategy??p.contribution}</p>{d?.constraints&&<p>{d.constraints}</p>}{d?.challenges&&<ul>{d.challenges.map(item=><li>{item}</li>)}</ul>}{d?.productDiscovery&&<details class="case-disclosure"><summary>{id?'Penemuan produk & konteks pengguna':'Product discovery & user context'} +</summary><ProductDiscovery discovery={d.productDiscovery} lang={lang}/></details>}{media[1]&&<figure class="case-inline-media">{media[1].kind==='video'?<video src={media[1].src} controls preload="none" poster={media[1].poster}/>:<img src={media[1].src} alt={media[1].alt} width="1600" height="1000" loading="lazy"/>}<figcaption>{media[1].caption}</figcaption></figure>}</section>
  <section id="implementation" class="case-section"><span class="eyebrow">{sections[2]}</span><h2>{id?'Yang saya bangun.':'What I built.'}</h2><p>{p.contribution}</p>{d?.implementation&&<p>{d.implementation}</p>}{d?.mySpecificBuilds&&<ul>{d.mySpecificBuilds.map(item=><li>{item}</li>)}</ul>}{d?.systemArchitecture&&<details class="case-disclosure" open><summary>{id?'Arsitektur sistem':'System architecture'} +</summary><p>{d.systemArchitecture}</p></details>}{d?.userFlow&&<details class="case-disclosure"><summary>{id?'Alur pengguna':'User flow'} +</summary><p>{d.userFlow}</p></details>}{d?.aiSystem&&<div class="case-pipeline"><h3>{id?'Telusuri pipeline':'Explore the pipeline'}</h3>{d.aiSystem.pipeline.map((step,i)=><details><summary><span class="eyebrow">{String(i+1).padStart(2,'0')}</span>{step}</summary><p>{i===0?d.aiSystem?.dataFlow:i===d.aiSystem!.pipeline.length-1?d.aiSystem?.validation:step}</p></details>)}</div>}</section>
  <section id="results" class="case-section"><span class="eyebrow">{sections[3]}</span><h2>{id?'Hasil, dengan konteks.':'Results, with context.'}</h2><p class="case-lead">{p.outcome??d?.results??p.statusLabel}</p>{d?.results&&d.results!==p.outcome&&<p>{d.results}</p>}{d?.metrics&&<div class="case-metrics">{d.metrics.map(m=><div><strong>{m.value}</strong><h3>{m.label}</h3>{m.context&&<p>{m.context}</p>}</div>)}</div>}{d?.lessonsLearned&&<details class="case-disclosure" open><summary>{id?'Pelajaran & langkah berikutnya':'Lessons & next steps'} +</summary><ul>{d.lessonsLearned.map(item=><li>{item}</li>)}</ul></details>}</section>
  <section id="technical" class="case-section"><span class="eyebrow">{sections[4]}</span><h2>{id?'Lebih dalam.':'Under the hood.'}</h2><details class="case-disclosure"><summary>{id?'Teknologi & fitur':'Technologies & features'} +</summary><p>{p.technologies.join(' / ')}</p><ul>{d?.keyFeatures.map(item=><li>{item}</li>)}</ul></details>{d?.featureStatus&&<details class="case-disclosure"><summary>{id?'Status fitur & batasan':'Feature status & limitations'} +</summary><div class="feature-list">{d.featureStatus.map(f=><div><h3>{f.name}</h3><span class="eyebrow">{id?({working:'Berfungsi',prototype:'Prototipe',planned:'Direncanakan',unvalidated:'Belum tervalidasi'})[f.status]:f.status}</span><p>{f.note}</p></div>)}</div></details>}{d?.aiSystem&&<details class="case-disclosure"><summary>{id?'Catatan sistem AI':'AI system notes'} +</summary>{Object.entries(d.aiSystem).filter(([key])=>key!=='pipeline').map(([key,value])=><div><h3>{aiLabels[key]??key}</h3><p>{value}</p></div>)}</details>}{p.slug==='tailor-cooperative-system'&&<details class="case-disclosure" open><summary>{id?'SAKTI: dokumentasi lengkap':'SAKTI: complete project documentation'} +</summary><SaktiCaseStudy project={p} lang={lang}/></details>}</section>
  <section class="case-section"><h2>{id?'Lanjut menjelajah.':'Keep exploring.'}</h2><div class="archive-grid case-related">{related.map(item=><a class="archive-item" href={`${prefix}/work/${item.slug}/`}>{item.screenshot&&<img src={item.screenshot} alt={item.title} width="800" height="500" loading="lazy"/>}<span class="eyebrow">{item.statusLabel}</span><h3>{displayName(item)} ↗</h3></a>)}</div><div class="actions"><a class="primary" href={`${prefix}/#work`}>← {id?'Kembali ke karya':'Back to work'}</a><a href={`${prefix}/#contact`}>{c.contact} ↗</a></div></section>
</article>
